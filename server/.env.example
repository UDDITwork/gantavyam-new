# Cloudinary Configuration
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# JWT Configuration
JWT_EXPIRE=1d
JWT_SECRET=your_jwt_secret_key_here

# Database (Turso / libSQL)
# Production: the libsql:// URL of your Turso database and an auth token for it
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token
# Local development without a cloud database: use a SQLite file instead (no token needed)
# TURSO_DATABASE_URL=file:./data/gantavyam.db

# Server Configuration
PORT=5000
NODE_ENV=development

# Extra browser origins allowed by CORS / Socket.IO (comma-separated), e.g. your Vercel URL
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Configuration
FAST2SMS_API_KEY=your_fast2sms_api_key

# Test Configuration
TEST_MOBILE=1234567890

# Default Admin Credentials
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password